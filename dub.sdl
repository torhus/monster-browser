name "monster-browser"
description "A server browser for Quake 3, mods, and derivates."
authors "torhu"
copyright "Copyright © 2026, torhu"

#dependency "dwt" version="~>1.0.5"
dependency "dwt" repository="git+https://github.com/d-widget-toolkit/dwt.git" \
                 version="3287055b2dd2392b1ca23b434e71460f29abbe29"
dependency "fswatch" version="~>0.6.0"
dependency "undead" version="~>1.1.7"
targetName "MonsterBrowser"
targetType "executable"
buildRequirements "silenceDeprecations"
#dflags "-verrors=0"
lflags "misc\\mb.res" platform="x86"
lflags "misc\\mb.res" platform="windows-x86_64"
mainSourceFile "src/main.d"
excludedSourceFiles "src/mswindows/*" platform="linux"
stringImportPaths "." "flags" "icons"
preBuildCommands "git rev-parse --abbrev-ref HEAD > revision.txt" \
                 "git describe --always --dirty >> revision.txt"
postBuildCommands "copy libcurl32.dll libcurl.dll" platform="windows-x86"
postBuildCommands "copy libcurl64.dll libcurl.dll" platform="windows-x86_64"

configuration "windows" {
	lflags "/subsystem:windows,5.01" platform="x86"
	lflags "/subsystem:windows,5.02" platform="windows-x86_64"
	lflags "/entry:mainCRTStartup" platform="x86-dmd"
	lflags "/entry:mainCRTStartup" platform="windows-x86_64-dmd"
	# LDC uses wmain instead of main
	lflags "/entry:wmainCRTStartup" platform="windows-ldc"
}

configuration "console" {
	versions "console"
	lflags "/subsystem:console,5.01" platform="x86"
	lflags "/subsystem:console,5.02" platform="windows-x86_64"
}

configuration "final" {
	versions "Final"
	lflags "/subsystem:windows,5.01" platform="x86"
	lflags "/subsystem:windows,5.02" platform="windows-x86_64"
	lflags "/entry:mainCRTStartup" platform="x86-dmd"
	lflags "/entry:mainCRTStartup" platform="windows-x86_64-dmd"
	# LDC uses wmain instead of main
	lflags "/entry:wmainCRTStartup" platform="windows-ldc"
}

libs "atk-1.0" \
     "cairo" \
     "dl" \
     "fontconfig" \
     "gdk-x11-2.0" \
     "gdk_pixbuf-2.0" \
     "gio-2.0" \
     "glib-2.0" \
     "gmodule-2.0" \
     "gobject-2.0" \
     "gthread-2.0" \
     "gtk-x11-2.0" \
     "pango-1.0" \
     "pangocairo-1.0" \
     "X11" \
     "Xcomposite" \
     "Xcursor" \
     "Xdamage" \
     "Xext" \
     "Xfixes" \
     "Xi" \
     "Xinerama" \
     "Xrandr" \
     "Xrender" \
     "Xtst" \
     platform="linux"
